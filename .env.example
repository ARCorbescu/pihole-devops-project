# ==============================================================================
# Pi-hole Local & Tailscale Configuration
# ==============================================================================

# Pi-hole Web Admin Password (REQUIRED)
PIHOLE_PASSWORD=ChangeMeSecurely123!

# Timezone (e.g., Europe/Bucharest, Europe/London, America/New_York)
TZ=Europe/Bucharest

# Upstream DNS servers (Cloudflare + Google by default)
PIHOLE_UPSTREAM_DNS=1.1.1.1;8.8.8.8

# Host port mappings
# Change if port 53 or 80 is already in use locally (e.g., WEB_PORT=8080)
DNS_PORT=53
WEB_PORT=80

# Bash monitor polling interval (seconds)
BASH_MONITOR_INTERVAL=30

# ==============================================================================
# Tailscale (Optional)
# Only needed when running Tailscale inside Docker:
#   docker compose --profile tailscale up -d
# If using the native Tailscale app on your Mac/host, leave commented out.
# ==============================================================================
# TS_AUTHKEY=tskey-auth-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
# TS_EXTRA_ARGS=--accept-dns=false
